---
import { Font } from "astro:assets";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta
			property="og:description"
			content="Web designer and developer based in Bali, Indonesia, specializing in technical SEO and website optimization."
		/>
		<meta property="og:type" content="website" />
		<meta
			property="og:url"
			content="https://www.fikiandriyan.workers.dev/"
		/>
		<meta property="og:site_name" content="Fiki Andriyan" />
		<meta
			property="og:image"
			content="https://www.fikiandriyan.workers.dev/og-image.jpg"
		/>
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta
			name="twitter:description"
			content="Web designer and developer based in Bali, Indonesia, specializing in technical SEO and website optimization."
		/>
		<meta
			name="twitter:image"
			content="https://www.fikiandriyan.workers.dev/og-image.jpg"
		/>
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/favicon-180.png" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-serif" preload />
		<script is:inline>
			// Match the blog: apply an explicit theme choice (cookie) to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<slot />
		<script>
			import "../scripts/portfolio.js";
		</script>
		<!-- Cloudflare Web Analytics --><script is:inline type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "b0b19c4ee69044cd99962f8b224efae8"}'></script><!-- End Cloudflare Web Analytics -->
	</body>
</html>

<style is:global>
	@import "../styles/portfolio.css";
</style>
