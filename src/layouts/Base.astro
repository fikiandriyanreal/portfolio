---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { getSiteLocale } from "../utils/locale";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/blog-chrome.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;
const menuItems = menu?.items ?? [];

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

const TRAILING_SLASH = /\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "") || "/";

/** "page" for the current page, "true" for its parent section (e.g. Posts on a post). */
function navCurrent(url: string): "page" | "true" | undefined {
	let target: URL;
	try {
		target = new URL(url, Astro.url);
	} catch {
		return undefined;
	}
	if (target.origin !== Astro.url.origin || target.hash) return undefined;
	if (target.search && target.search !== Astro.url.search) return undefined;
	const path = target.pathname.replace(TRAILING_SLASH, "") || "/";
	if (path === currentPath) return "page";
	if (path !== "/" && currentPath.startsWith(`${path}/`)) return "true";
	return undefined;
}

const lang = getSiteLocale() ?? "en";
const onBlog = Astro.url.pathname.startsWith("/posts");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<Font cssVariable="--font-serif" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<header class="pf-header">
			<nav class="pf-nav" aria-label="Main">
				<a class="pf-brand" href="/">&copy; Fiki Andriyan</a>
				<div class="pf-nav-links">
					<a href="/#work">Work</a>
					<a href="/#about">About</a>
					<a href="/#contact">Contact</a>
					<a href="/posts" aria-current={onBlog ? "page" : undefined}>Blog</a>
				</div>
			</nav>
		</header>
		<button
			class="pf-menu-btn"
			aria-expanded="false"
			aria-controls="site-menu"
			aria-label="Open menu"
		>
			<span class="pf-menu-btn-inner"
				><span class="pf-menu-bars" aria-hidden="true"></span></span
			>
		</button>
		<div class="pf-site-menu" id="site-menu" aria-hidden="true">
			<div class="pf-menu-panel">
				<nav class="pf-menu-links" aria-label="Site menu">
					<a href="/#work"><span class="pf-menu-num">01</span>Work</a>
					<a href="/#about"><span class="pf-menu-num">02</span>About</a>
					<a href="/#contact"><span class="pf-menu-num">03</span>Contact</a>
					<a href="/posts" aria-current={onBlog ? "page" : undefined}
						><span class="pf-menu-num">04</span>Blog</a
					>
				</nav>
				<div class="pf-menu-contact">
					<a href="mailto:fikiandriyanreal@gmail.com"
						>fikiandriyanreal@gmail.com</a
					>
					<a
						href="https://wa.me/6285157124122?text=Hi+Fiki%2C+I%27d+like+to+ask+about+a+website+project."
						target="_blank"
						rel="noopener">WhatsApp</a
					>
					<a href="/Fiki-Andriyan-CV.pdf" download="Fiki-Andriyan-CV.pdf"
						>Download CV</a
					>
				</div>
			</div>
		</div>
		<script is:inline>
			// Inline, so the height is set before the browser scrolls to a URL fragment
			(function () {
				var header = document.querySelector(".pf-header");
				if (!header) return;
				function setHeight() {
					document.documentElement.style.setProperty(
						"--header-height",
						header.offsetHeight + "px",
					);
				}
				setHeight();
				new ResizeObserver(setHeight).observe(header);
			})();
		</script>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="pf-contact" id="contact">
			<div class="pf-wrap">
				<h2 class="pf-cta-title">
					<span class="pf-cta-avatar"
						><img src="/fiki.jpg" alt="" width="959" height="1198" /></span
					>Tell me about<br />your project.
				</h2>
				<p class="pf-cta-sub">
					Share what you're building and who it's for. Email or WhatsApp,
					whichever is easier.
				</p>
				<div class="pf-cta-row">
					<a class="pf-btn pf-btn--solid" href="mailto:fikiandriyanreal@gmail.com"
						>fikiandriyanreal@gmail.com</a
					>
					<a
						class="pf-btn pf-btn--ghost"
						href="https://wa.me/6285157124122?text=Hi+Fiki%2C+I%27d+like+to+ask+about+a+website+project."
						>WhatsApp</a
					>
					<a
						class="pf-btn pf-btn--ghost"
						href="/Fiki-Andriyan-CV.pdf"
						download="Fiki-Andriyan-CV.pdf">Download CV</a
					>
				</div>
				<p class="pf-cta-loc">
					Based in Bali &middot; GMT+8 &middot; English or Bahasa Indonesia
				</p>
				<div class="pf-foot">
					<span>&copy; {year} Fiki Andriyan</span>
					<span class="pf-clock">Bali, Indonesia</span>
					<div class="theme-switcher" role="group" aria-label="Color theme">
						<button type="button" class="theme-btn" data-theme="light" aria-label="Light">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
						</button>
						<button type="button" class="theme-btn" data-theme="dark" aria-label="Dark">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg>
						</button>
						<button type="button" class="theme-btn" data-theme="system" aria-label="System">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
						</button>
					</div>
				</div>
				<div class="pf-signoff" aria-hidden="true">
					<span style="--i:0">F</span><span style="--i:1">i</span><span style="--i:2">k</span><span style="--i:3">i</span><span class="sp" style="--i:4">&nbsp;</span><span style="--i:5">A</span><span style="--i:6">n</span><span style="--i:7">d</span><span style="--i:8">r</span><span style="--i:9">i</span><span style="--i:10">y</span><span style="--i:11">a</span><span style="--i:12">n</span><span class="dot" style="--i:13">.</span>
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "system";
			}

			// Initialize
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<script is:inline>
			// Portfolio chrome: hamburger overlay, footer signoff, live clock
			(function () {
				var menuBtn = document.querySelector(".pf-menu-btn");
				var menuEl = document.getElementById("site-menu");
				if (menuBtn && menuEl) {
					var menuOpen = false;
					var lastY = window.scrollY;
					var mobileMq = window.matchMedia("(max-width: 640px)");
					var fine = window.matchMedia("(pointer: fine)").matches;
					var reduce = window.matchMedia(
						"(prefers-reduced-motion: reduce)",
					).matches;
					var onScrollMenu = function () {
						var y = window.scrollY;
						document.body.classList.toggle("scrolled", y > 100);
						if (mobileMq.matches && !menuOpen) {
							if (y > 140 && y > lastY + 4)
								document.body.classList.add("menu-hidden");
							else if (y < lastY - 4 || y <= 140)
								document.body.classList.remove("menu-hidden");
						}
						lastY = y;
					};
					window.addEventListener("scroll", onScrollMenu, { passive: true });
					onScrollMenu();
					var setMenu = function (open) {
						menuOpen = open;
						if (open) document.body.classList.remove("menu-hidden");
						document.body.classList.toggle("menu-open", open);
						menuBtn.setAttribute("aria-expanded", String(open));
						menuBtn.setAttribute(
							"aria-label",
							open ? "Close menu" : "Open menu",
						);
						menuEl.setAttribute("aria-hidden", String(!open));
					};
					menuBtn.addEventListener("click", function () {
						setMenu(!menuOpen);
					});
					menuEl.querySelectorAll("a").forEach(function (a) {
						a.addEventListener("click", function () {
							setMenu(false);
						});
					});
					window.addEventListener("keydown", function (e) {
						if (e.key === "Escape" && menuOpen) setMenu(false);
					});
					if (fine && !reduce) {
						var inner = menuBtn.querySelector(".pf-menu-btn-inner");
						menuBtn.addEventListener("mousemove", function (e) {
							var r = menuBtn.getBoundingClientRect();
							var x = (e.clientX - r.left - r.width / 2) * 0.3;
							var y = (e.clientY - r.top - r.height / 2) * 0.3;
							inner.style.transform =
								"translate(" + x + "px," + y + "px)";
						});
						menuBtn.addEventListener("mouseleave", function () {
							inner.style.transform = "";
						});
					}
				}

				var signoff = document.querySelector(".pf-signoff");
				if (signoff) {
					var reduceMotion = window.matchMedia(
						"(prefers-reduced-motion: reduce)",
					).matches;
					if ("IntersectionObserver" in window && !reduceMotion) {
						var so = new IntersectionObserver(
							function (es) {
								es.forEach(function (e) {
									if (e.isIntersecting) {
										signoff.classList.add("in");
										so.disconnect();
									}
								});
							},
							{ threshold: 0.2 },
						);
						so.observe(signoff);
					} else {
						signoff.classList.add("in");
					}
				}

				var clock = document.querySelector(".pf-clock");
				if (clock) {
					var tick = function () {
						try {
							var t = new Date().toLocaleTimeString("en-GB", {
								hour: "2-digit",
								minute: "2-digit",
								timeZone: "Asia/Makassar",
							});
							clock.textContent = "Indonesia (GMT+8) \u00b7 " + t;
						} catch (err) {}
					};
					tick();
					setInterval(tick, 30000);
				}
			})();
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
					-webkit-text-size-adjust: 100%;
				}

				/*
				 * Fragment targets clear the sticky header. Not a scroll-padding
				 * on html: that also applies to the search field inside the
				 * header, and the page scrolls on every keystroke.
				 * --header-height is measured by a script, since the header
				 * grows when the menu wraps.
				 */
				:target {
					scroll-margin-block-start: calc(
						var(--header-height, var(--nav-height)) + var(--spacing-6)
					);
				}

				body {
					display: flex;
					flex-direction: column;
					min-height: 100vh;
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
				}

				/*
				 * The frame rails: two hairlines that run the full height of
				 * the page at the edges of the content frame. Fixed and behind
				 * everything, so any surface with a background covers them.
				 */
				body::before {
					content: "";
					position: fixed;
					inset-block: 0;
					inset-inline: 0;
					z-index: -1;
					width: var(--frame-width);
					margin-inline: auto;
					border-inline: 1px solid var(--color-border);
					pointer-events: none;
				}

				main {
					flex: 1;
				}

				main:focus {
					outline: none;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration-line: underline;
					text-decoration-thickness: 1px;
					text-decoration-color: var(--color-border-strong);
					text-underline-offset: 0.2em;
					transition:
						color var(--transition-fast),
						text-decoration-color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					text-decoration-color: currentColor;
				}

				:where(:not([class*="emdash"]):not([class*="ec-"])):focus-visible {
					outline: 2px solid var(--color-brand);
					outline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
					text-wrap: balance;
					overflow-wrap: break-word;
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				p {
					text-wrap: pretty;
				}

				kbd {
					font-family: var(--font-mono);
				}

				@media (max-width: 640px) {
					:target {
						scroll-margin-block-start: var(--spacing-6);
					}
				}

				@media (prefers-reduced-motion: reduce) {
					html {
						scroll-behavior: auto;
					}

					*,
					*::before,
					*::after {
						transition-duration: 0.01ms !important;
						animation-duration: 0.01ms !important;
						animation-iteration-count: 1 !important;
					}
				}

				/* Shared building blocks used by every page */

				.sr-only {
					position: absolute;
					width: 1px;
					height: 1px;
					padding: 0;
					margin: -1px;
					overflow: hidden;
					clip-path: inset(50%);
					white-space: nowrap;
					border: 0;
				}

				.skip-link {
					position: fixed;
					top: var(--spacing-2);
					inset-inline-start: var(--spacing-2);
					z-index: 200;
					padding: var(--spacing-2) var(--spacing-4);
					border-radius: var(--radius-full);
					background: var(--color-brand);
					color: var(--color-on-brand);
					font-size: var(--font-size-sm);
					font-weight: 500;
					text-decoration: none;
					translate: 0 calc(-100% - var(--spacing-4));
					transition: translate var(--transition-fast);
				}

				.skip-link:focus-visible {
					translate: 0 0;
				}

				/* Content frame: aligned with the rails */
				.frame {
					width: var(--frame-width);
					margin-inline: auto;
					padding-inline: var(--frame-padding);
				}

				/* A full-bleed horizontal section, ruled off with a hairline */
				.band {
					position: relative;
					border-top: 1px solid var(--color-border);
				}

				/* Crosshairs where the band's rule meets the rails */
				.band::before,
				.band::after {
					content: "";
					position: absolute;
					top: -5px;
					width: 9px;
					height: 9px;
					background:
						linear-gradient(
								var(--color-border-strong),
								var(--color-border-strong)
							)
							center / 1px 100% no-repeat,
						linear-gradient(
								var(--color-border-strong),
								var(--color-border-strong)
							)
							center / 100% 1px no-repeat;
					pointer-events: none;
				}

				.band::before {
					inset-inline-start: calc((100% - var(--frame-width)) / 2 - 4px);
				}

				.band::after {
					inset-inline-end: calc((100% - var(--frame-width)) / 2 - 4px);
				}

				main > .band:first-child {
					border-top: 0;
				}

				main > .band:first-child::before,
				main > .band:first-child::after {
					content: none;
				}

				/* Vertical rhythm for content bands */
				.section {
					padding-block: clamp(2.5rem, 1.75rem + 2.5vw, 4rem);
				}

				/* Page intro: eyebrow, display title, optional lead */
				.intro {
					padding-block: clamp(3rem, 2rem + 4vw, 5.5rem)
						clamp(2.5rem, 1.75rem + 2.5vw, 3.5rem);
				}

				.intro__title {
					font-size: var(--font-size-display);
					line-height: 1.05;
					max-width: 22ch;
				}

				.intro__subtitle {
					font-size: var(--font-size-display);
					font-weight: var(--font-weight-display);
					line-height: 1.05;
					letter-spacing: var(--tracking-tight);
					color: var(--color-muted);
					max-width: 22ch;
